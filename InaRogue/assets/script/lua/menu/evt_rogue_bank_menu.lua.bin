-- ---- helpers --------------------------------------------------------------------------------------------------
local function Call(cmd, ...)
  local r = table.pack(pcall(funcLuaCommand, cmd, ...))
  if not r[1] then
    return nil
  end
  return table.unpack(r, 2, r.n)
end

local function Log(...)
  Call(RL.LOG, "rogue_bank", ...)
end

local function Int(v)
  if type(v) ~= "number" then
    return 0
  end
  return math.floor(v + 0.5)
end

local function Plural(n)
  return n == 1 and "" or "s"
end

local function Tier(e)
  return math.max(1, math.min(5, e.tier))
end

local function Pct(n, total)
  if total <= 0 then
    return "0"
  end
  return (string.format("%.1f", n * 100 / total):gsub("%.", ","))
end

-- at most n bytes, never cutting a UTF-8 sequence
local function Short(s, n)
  if #s <= n then
    return s
  end
  local k = n
  while k > 1 and s:byte(k + 1) ~= nil and s:byte(k + 1) >= 128 and s:byte(k + 1) < 192 do
    k = k - 1
  end
  return s:sub(1, k) .. "..."
end

-- card i (0-based) of the album in the current order (CMND_EVT_RL_ALBUM_INFO op 4)
local function AlbumEntry(i)
  local ok, param, owned, tier, uid, team, towned, tcount, cost, runs, added, tname, whatif = Call(RL.ALBUM, 4, i, album.order)
  if ok ~= true then
    return nil
  end
  local e = {album = true, param = param, owned = owned == true, tier = Int(tier), uid = uid, team = Int(team),
             towned = Int(towned), tcount = Int(tcount), cost = Int(cost), runs = Int(runs), added = Int(added),
             tname = type(tname) == "string" and tname or "?", level = 5, card = 0, name = TXT.ALBUM_UNKNOWN,
             element = 0, position = 0, scost = 0, frags = 0, picked = false, fits = true, inslot = -1,
             whatif = whatif == true}
  if e.owned then
    local _, name = Call(CMD_CHARA_INFO, param, 0)
    local _, _, _, _, _, element, position = Call(RL.CHARA, param)
    e.name = (type(name) == "string" and name or "?") .. (e.whatif and TXT.WI_TAG or "")
    e.element, e.position = Int(element), Int(position)
  end
  return e
end

-- entry i (0-based) of the bank in the current sort, read from the loader on first use
local function Entry(i)
  if i == nil or i < 0 or i >= count then
    return nil
  end
  local e = cache[i]
  if e ~= nil then
    return e
  end
  if album.on then
    e = AlbumEntry(i)
    if e ~= nil then
      if cached >= 256 then
        cache, cached = {}, 0
      end
      cache[i] = e
      cached = cached + 1
    end
    return e
  end
  local ok, uid, param, level, tier, cost, runs, added, card, scost, frags, whatif = Call(RL.GET, i, sort)
  if ok ~= true then
    return nil
  end
  local _, name = Call(CMD_CHARA_INFO, param, 0)
  local _, _, _, _, _, element, position = Call(RL.CHARA, param)
  e = {uid = uid, param = param, level = Int(level), tier = Int(tier), cost = Int(cost), runs = Int(runs),
       added = Int(added), card = Int(card), name = (type(name) == "string" and name or "?") .. (whatif == true and TXT.WI_TAG or ""),
       element = Int(element), position = Int(position), scost = Int(scost), frags = Int(frags), picked = false,
       whatif = whatif == true}
  if pick_mode then
    e.picked = Call(RL.PICK_STATE, uid) == true
  end
  if slot_mode.on then
    local fits, inslot, scost = Call(RL.TEAM_FITS, uid, slot_mode.slot)
    e.fits, e.inslot, e.scost = fits == true, Int(inslot), Int(scost)
  end
  if cached >= 256 then      -- a few screens are enough; 6000 entries are never all read
    cache, cached = {}, 0
  end
  cache[i] = e
  cached = cached + 1
  return e
end

local function Current()
  return Entry(sel)
end

local function ReadBank()
  count, cache, cached = 0, {}, 0
  local api, mods = Call(RL.VERSION)
  has_loader = type(api) == "number" and type(mods) == "number" and math.floor(mods / MOD_ROGUE) % 2 == 1
  if not has_loader then
    return
  end
  if album.on then
    local teams, total, owned = Call(RL.ALBUM, 0)
    album.teams, album.total, album.owned = Int(teams), Int(total), Int(owned)
    count = math.max(0, Int(Call(RL.ALBUM, 3, album.order)))
    if sel >= count then
      sel = math.max(0, count - 1)
    end
    return
  end
  local n, cap, _, bud = Call(RL.COUNT)
  count, capacity, budget = math.max(0, Int(n)), Int(cap), Int(bud)
  if sel >= count then
    sel = math.max(0, count - 1)
  end
end

-- keep `sel` inside the visible window (whole rows)
local function FitOffset()
  local row = math.floor(sel / COLS)
  local first = math.floor(offset / COLS)
  if row < first then
    first = row
  elseif row >= first + ROWS then
    first = row - ROWS + 1
  end
  local rows_total = math.max(1, math.ceil(count / COLS))
  first = math.max(0, math.min(first, rows_total - ROWS))
  offset = first * COLS
end

-- ---- cards -----------------------------------------------------------------------------------------------------------
-- mouse: grid card idx takes hover / click only while it shows a player (the panel card never)
local function SetHit(idx, on)
  on = on and idx ~= PANEL
  funcLuaMenuCommand(MS.HIT, L_CARD, idx, on)
  funcLuaMenuCommand(MS.HOVER, L_CARD, idx, on)
end

local function HideCard(idx)
  funcLuaMenuCommand(C.LAYER_VISIBLE, L_CARD, idx, false)
  funcLuaMenuCommand(C.LAYER_VISIBLE, L_NEW, idx, false)
  SetHit(idx, false)
end

local function DrawCard(idx, e)
  if e == nil then
    HideCard(idx)
    return
  end
  SetHit(idx, true)
  if not card_ready[idx] then
    return            -- drawn again from OnOpenLayer once the card's node names are set
  end
  funcLuaMenuCommand(C.LAYER_VISIBLE, L_CARD, idx, true)
  funcLuaMenuCommand(C.MESH_VISIBLE, L_CARD, CARD_FACE, false, idx)
  -- the exact argument list of the retail seasonal roster cards (unowned players by param id); rarity 4 = 5 stars.
  -- «What if» cards: rarity 5 (Hero type) so the position_cards graft draws the card's own frame (EVT_IDOL_FRAME NN)
  local rar = e.whatif and 5 or 4
  local ok = funcLuaMenuCommand(CMD_CARD, L_CARD, idx, e.param, true, false, 0, 0, e.level, false, false, rar, 0, false, true, 0, false, true)
  funcLuaMenuCommand(CMD_CARD_APPLY, L_CARD, idx)
  local secret = e.album == true and not e.owned      -- album card not owned yet: no face, no element / position
  face_wait[idx] = (not secret) and 120 or nil
  if idx == 0 or idx == PANEL then
    Log("card", idx, e.param, "ret", tostring(ok))
  end
  for _, m in ipairs(CARD_HIDE) do
    funcLuaMenuCommand(C.MESH_VISIBLE, L_CARD, m, false, idx)
  end
  for _, m in ipairs(CARD_LV_MESHES) do
    funcLuaMenuCommand(C.MESH_VISIBLE, L_CARD, m, false, idx)
  end
  for _, prim in ipairs(CARD_LV_PRIMS) do
    funcLuaMenuCommand(C.PRIM_VISIBLE, L_CARD, idx, CRC32(prim), false)
  end
  if e.album then
    funcLuaMenuCommand(C.TEXT, L_CARD, CARD_NAME, secret and TXT.ALBUM_UNKNOWN or "", idx)
    funcLuaMenuCommand(CMD_TEXT_VISIBLE, L_CARD, CARD_NAME, secret, idx)
    funcLuaMenuCommand(C.MESH_VISIBLE, L_CARD, CARD_GREY, secret, idx)
    for _, m in ipairs(CARD_SECRET) do
      funcLuaMenuCommand(C.MESH_VISIBLE, L_CARD, m, not secret, idx)
    end
  elseif slot_mode.on then
    local t = e.inslot == slot_mode.slot and TXT.CARD_HERE or (e.inslot >= 0 and TXT.CARD_TEAM or TXT.CARD_COST)
    funcLuaMenuCommand(C.TEXT, L_CARD, CARD_NAME, string.format(t, e.scost), idx)
    funcLuaMenuCommand(CMD_TEXT_VISIBLE, L_CARD, CARD_NAME, true, idx)
    funcLuaMenuCommand(C.MESH_VISIBLE, L_CARD, CARD_GREY, not e.fits, idx)
  elseif pick_mode then
    -- the name line shows the starter cost; picked players say so, unaffordable ones are greyed (retail grey-out)
    funcLuaMenuCommand(C.TEXT, L_CARD, CARD_NAME, string.format(e.picked and TXT.CARD_PICKED or TXT.CARD_COST, e.scost), idx)
    funcLuaMenuCommand(CMD_TEXT_VISIBLE, L_CARD, CARD_NAME, true, idx)
    local blocked = not e.picked and (squad.n >= squad.size or squad.spent + e.scost > squad.budget)
    funcLuaMenuCommand(C.MESH_VISIBLE, L_CARD, CARD_GREY, blocked, idx)
  else
    funcLuaMenuCommand(C.TEXT, L_CARD, CARD_NAME, "", idx)
    funcLuaMenuCommand(CMD_TEXT_VISIBLE, L_CARD, CARD_NAME, false, idx)
  end
  funcLuaMenuCommand(C.MESH_VISIBLE, L_CARD, CARD_FOCUS, false, idx)
  local t = Tier(e)
  if TIER_CARDS and not e.whatif then
    local tex = CRC32(TEX_PATH)
    funcLuaMenuCommand(C.SPRITE, L_CARD, tex, CRC32(string.format("evt_rogue_card_base_%02d", t)), NODE_BASE, 0, idx)
    funcLuaMenuCommand(C.SPRITE, L_CARD, tex, CRC32(string.format("evt_rogue_card_color_%02d", t)), NODE_COLOR, 0, idx)
  end
  if FRONT_MARK then
    funcLuaMenuCommand(C.LAYER_VISIBLE, L_NEW, idx, true)
    funcLuaMenuCommand(C.SCALE, L_NEW, MARK_SCALE_X, MARK_SCALE_Y, 1, idx)
    funcLuaMenuCommand(C.SPRITE, L_NEW, CRC32(TEX_PATH), CRC32(string.format("evt_rogue_mark_wide_%02d", t)), NODE_NEW, 0, idx)
  else
    funcLuaMenuCommand(C.LAYER_VISIBLE, L_NEW, idx, false)
  end
end

local function PollFaces()
  for idx, left in pairs(face_wait) do
    if not funcLuaMenuCommand(CMD_LOADING, L_CARD, idx) or left <= 0 then
      funcLuaMenuCommand(C.MESH_VISIBLE, L_CARD, CARD_FACE, true, idx)
      face_wait[idx] = nil
      if idx == 0 then
        Log("card 0 portrait shown after", 120 - left, "frames")
      end
    else
      face_wait[idx] = left - 1
    end
  end
end

local function DrawGrid()
  for k = 0, N_GRID - 1 do
    DrawCard(k, Entry(offset + k))
  end
end

local function ShowCursor()
  local k = sel - offset
  if shown >= 0 and shown ~= k then
    funcLuaMenuCommand(C.ATTACH_TRACE, L_CARD, shown, CARD_CURSOR, false)
    funcLuaMenuCommand(C.MESH_VISIBLE, L_CARD, CARD_FOCUS, false, shown)
  end
  if count == 0 then
    funcLuaMenuCommand(C.LAYER_VISIBLE, L_CURSOR, 0, false)
    shown = -1
    return
  end
  funcLuaMenuCommand(C.LAYER_VISIBLE, L_CURSOR, 0, true)
  funcLuaMenuCommand(C.ATTACH_TRACE, L_CARD, k, CARD_CURSOR, true)
  funcLuaMenuCommand(C.CURSOR_LOC, L_CARD, CARD_CURSOR, k, N_GRID + 1)
  funcLuaMenuCommand(C.MESH_VISIBLE, L_CARD, CARD_FOCUS, true, k)
  shown = k
  -- mouse: when the pointer left the engine focus on a card, keys move it along (Enter decides the same card)
  if funcLuaMenuCommand(MS.FOCUS_ACTIVE, L_CARD) then
    funcLuaMenuCommand(C.FOCUS_SET, L_CARD, k)
  end
end

-- ---- guide line and button guide ---------------------------------------------------------------------------------------
local function UpdateGuideLine()
  local t
  if not has_loader then
    t = TXT.GUIDE_NO_LOADER
  elseif album.on then
    local pct = Pct(album.owned, album.total)
    local e = Current()
    if e == nil then
      t = string.format(TXT.ALBUM_GUIDE_NONE, album.owned, album.total, pct, TXT.ALBUM_TAIL[album.order + 1])
    else
      t = string.format(TXT.ALBUM_GUIDE, album.owned, album.total, pct, Short(e.tname, 24), e.towned, e.tcount,
                        TXT.ALBUM_TAIL[album.order + 1])
    end
  elseif slot_mode.on then
    t = string.format(TXT.GUIDE_SLOT, slot_mode.left)
  elseif pick_mode then
    t = string.format(TXT.GUIDE_PICK, squad.n, squad.size, squad.spent, squad.budget)
  elseif count == 0 then
    t = TXT.GUIDE_EMPTY
  else
    t = string.format(TXT.GUIDE, count, TXT.SORT[sort + 1])
  end
  funcLuaMenuCommand(C.TEXT, L_GUIDE_LINE, 378156699 --[[_text_guide01]], t, 0)
end

local function UpdateButtonGuide()
  local texts, icons, offs, cmds
  if album.on then
    -- Ordenar / Cambiar página (R1; L1 goes back) / Equipo (R2; L2 goes back; not in the rarity order) / Aceptar
    texts, icons, offs, cmds = {G_SORT, G_PAGE}, {I_FUNC2, I_R1}, {0, 0}, {K_FUNC2, K_R1}
    if album.order ~= 1 then
      texts[#texts + 1], icons[#icons + 1], offs[#offs + 1], cmds[#cmds + 1] = G_TEAM, I_R2, 0, K_R2
    end
    texts[#texts + 1], icons[#icons + 1], offs[#offs + 1], cmds[#cmds + 1] = G_ACCEPT, I_ENTER, 18, K_ENTER
  elseif slot_mode.on then
    texts, icons, offs = {G_SORT, G_PICK}, {I_FUNC2, I_ENTER}, {0, 18}
    cmds = {K_FUNC2, K_ENTER}
  elseif pick_mode then
    texts, icons, offs = {G_SORT, G_PICK, G_GO}, {I_FUNC2, I_ENTER, I_FUNC3}, {0, 18, -18}
    cmds = {K_FUNC2, K_ENTER, K_FUNC3}
  elseif count > 0 then
    texts, icons, offs = {G_SORT, G_ACCEPT}, {I_FUNC2, I_ENTER}, {0, 18}
    cmds = {K_FUNC2, K_ENTER}
  else
    texts, icons, offs, cmds = {G_ACCEPT}, {I_ENTER}, {0}, {K_ENTER}
  end
  funcLuaMenuCommand(C.GUIDE_SET, MENU, L_BTN_GUIDE, texts, icons, offs, {}, {})
  funcLuaMenuCommand(C.GUIDE_CMD, MENU, L_BTN_GUIDE, cmds)
  funcLuaMenuCommand(C.GUIDE_OPT, MENU, L_BTN_GUIDE, false)
end

-- ---- detail window ---------------------------------------------------------------------------------------------------
local function WinText(node, s)
  funcLuaMenuCommand(C.TEXT, L_WIN, node, s, 0)
end

local function WinMesh(mesh, visible)
  funcLuaMenuCommand(C.MESH_VISIBLE, L_WIN, mesh, visible, 0)
end

local function WinPrim(name, value, visible)
  local prim = funcLuaMenuCommand(C.PRIM_INDEX, L_WIN, 0, name)
  if prim ~= nil then
    funcLuaMenuCommand(C.PRIM_VALUE, L_WIN, 0, prim, value)
  end
  funcLuaMenuCommand(C.PRIM_VISIBLE, L_WIN, 0, name, visible)
end

-- album mode panel: owned = name, position - element, team, cost, rarity, date; missing = "???", rarity and team only
local function FillDetailAlbum(e)
  if e == nil then
    local complete = album.total > 0 and album.owned >= album.total
    WinMesh(N.STORY_IMG, false)
    WinMesh(N.CH_IMG, false)
    WinText(N.TITLE, complete and TXT.A_COMPLETE_TITLE or TXT.A_EMPTY_TITLE)
    WinText(N.SUB[3], "")
    WinText(N.SUB[4], "")
    WinText(N.CAT[3], complete and TXT.A_COMPLETE_1 or (has_loader and TXT.A_EMPTY_1 or TXT.P_NO_LOADER))
    for _, node in ipairs({N.CAT[4], N.CAT[2], N.CAT[1], N.DATE}) do
      WinText(node, "")
    end
    WinPrim(P.MAX, 0, false)
    WinPrim(P.AVG, 0, false)
    funcLuaMenuCommand(C.LAYER_VISIBLE, L_CARD, PANEL, false)
    funcLuaMenuCommand(C.LAYER_VISIBLE, L_NEW, PANEL, false)
    return
  end
  local tier = Tier(e)
  WinText(N.TITLE, e.owned and e.name or TXT.ALBUM_UNKNOWN)
  WinMesh(N.STORY_IMG, true)
  funcLuaMenuCommand(C.SPRITE, L_WIN, CRC32(TEX_PATH), CRC32(string.format("evt_rogue_banner_%02d", tier)), N.STORY_IMG_NODE, 0, 0)
  WinMesh(N.CH_IMG, true)
  funcLuaMenuCommand(C.SPRITE, L_WIN, CRC32(IMG_CH.path), CRC32(IMG_CH.name), N.CH_IMG_NODE, 0, 0)
  if e.owned then
    WinText(N.SUB[3], string.format(TXT.P_POS_ELEM, TXT.POS[e.position] or TXT.UNKNOWN, TXT.ELEM[e.element] or TXT.UNKNOWN))
    WinText(N.CAT[3], TXT.P_COST)
    WinPrim(P.MAX, e.cost, true)
    WinText(N.CAT[1], TXT.P_ADDED)
    local a = e.added
    if a > 19000000 then
      WinText(N.DATE, string.format(TXT.P_DATE, a % 100, math.floor(a / 100) % 100, math.floor(a / 10000)))
    else
      WinText(N.DATE, TXT.UNKNOWN)
    end
  else
    WinText(N.SUB[3], TXT.A_NOT_OWNED)
    WinText(N.CAT[3], TXT.A_COST_HIDDEN)
    WinPrim(P.MAX, 0, false)
    WinText(N.CAT[1], TXT.A_ADDED_NO)
    WinText(N.DATE, "")
  end
  WinText(N.SUB[4], Short(e.tname, 30))
  WinText(N.CAT[4], string.format(TXT.A_TEAM, e.towned, e.tcount))
  WinPrim(P.AVG, 0, false)
  WinText(N.CAT[2], string.format(e.whatif and TXT.P_RARITY_WI or TXT.P_RARITY, tier, Plural(tier)))
  DrawCard(PANEL, e)
end

local function FillDetail()
  local e = Current()
  for _, l in ipairs({N.PLATFORM, N.CH_STARS, N.FACES, N.COLONS, N.VICTORY_MESH, N.MODE_BASE}) do
    for _, m in ipairs(l) do
      WinMesh(m, false)
    end
  end
  WinMesh(N.STORY_STAR, false)
  for _, p in ipairs({P.H, P.M, P.S, P.H2, P.M2, P.S2, P.MAX2, P.AVG2, P.VIC, P.VIC_BIG}) do
    WinPrim(p, 0, false)
  end
  for _, node in ipairs({N.CAT[5], N.CAT[6], N.SUB[1], N.SUB[2]}) do
    WinText(node, "")
  end
  if album.on then
    FillDetailAlbum(e)
    return
  end
  if e == nil then
    WinMesh(N.STORY_IMG, false)
    WinMesh(N.CH_IMG, false)
    WinText(N.TITLE, TXT.P_EMPTY_TITLE)
    WinText(N.SUB[3], "")
    WinText(N.SUB[4], "")
    WinText(N.CAT[3], has_loader and TXT.P_EMPTY_1 or TXT.P_NO_LOADER)
    WinText(N.CAT[4], has_loader and TXT.P_EMPTY_2 or "")
    WinText(N.CAT[2], has_loader and TXT.P_EMPTY_3 or "")
    WinText(N.CAT[1], "")
    WinText(N.DATE, "")
    WinPrim(P.MAX, 0, false)
    WinPrim(P.AVG, 0, false)
    funcLuaMenuCommand(C.LAYER_VISIBLE, L_CARD, PANEL, false)
    funcLuaMenuCommand(C.LAYER_VISIBLE, L_NEW, PANEL, false)
    return
  end
  local tier = Tier(e)
  WinText(N.TITLE, e.name)
  -- band 1: the tier strip; band 2: the retail chronicle picture with the card on the left and white texts on the right
  WinMesh(N.STORY_IMG, true)
  funcLuaMenuCommand(C.SPRITE, L_WIN, CRC32(TEX_PATH), CRC32(string.format("evt_rogue_banner_%02d", tier)), N.STORY_IMG_NODE, 0, 0)
  WinMesh(N.CH_IMG, true)
  funcLuaMenuCommand(C.SPRITE, L_WIN, CRC32(IMG_CH.path), CRC32(IMG_CH.name), N.CH_IMG_NODE, 0, 0)
  WinText(N.SUB[3], string.format(TXT.P_POS_ELEM, TXT.POS[e.position] or TXT.UNKNOWN, TXT.ELEM[e.element] or TXT.UNKNOWN))
  WinText(N.SUB[4], string.format(TXT.P_LEVEL, e.runs))
  if pick_mode or slot_mode.on then
    local _, _, frags, nextStep = Call(RL.PICK_STATE, e.uid)
    if Int(nextStep) > 0 then
      WinText(N.SUB[4], string.format(TXT.P_FRAGS, Int(frags), Int(nextStep)))
    else
      WinText(N.SUB[4], string.format(TXT.P_FRAGS_MAX, Int(frags)))
    end
    WinText(N.CAT[3], TXT.P_START_COST)
    WinPrim(P.MAX, e.scost, true)
    WinText(N.CAT[4], TXT.P_BUDGET_PICK)
    WinPrim(P.AVG, slot_mode.on and slot_mode.left or (squad.budget - squad.spent), true)
  else
    WinText(N.CAT[3], TXT.P_COST)
    WinPrim(P.MAX, e.cost, true)
    WinText(N.CAT[4], TXT.P_BUDGET)
    WinPrim(P.AVG, budget, true)
  end
  WinText(N.CAT[2], string.format(e.whatif and TXT.P_RARITY_WI or TXT.P_RARITY, tier, Plural(tier)))
  WinText(N.CAT[1], TXT.P_ADDED)
  local a = e.added
  if a > 19000000 then
    WinText(N.DATE, string.format(TXT.P_DATE, a % 100, math.floor(a / 100) % 100, math.floor(a / 10000)))
  else
    WinText(N.DATE, TXT.UNKNOWN)
  end
  DrawCard(PANEL, e)
end

local function RefreshAll()
  FitOffset()
  DrawGrid()
  ShowCursor()
  FillDetail()
  UpdateGuideLine()
  UpdateButtonGuide()
end

local function Move(delta)
  if count == 0 then
    return
  end
  local new = sel + delta
  if new < 0 or new >= count then
    if delta == COLS and math.floor(sel / COLS) < math.floor((count - 1) / COLS) then
      new = count - 1     -- down onto a shorter last row
    else
      return
    end
  end
  sel = new
  local old = offset
  FitOffset()
  if offset ~= old then
    DrawGrid()
  end
  funcLuaCommand(C.SE, SE_OK)
  ShowCursor()
  FillDetail()
  if album.on then
    UpdateGuideLine()
  end
end

-- L1/R1: one page (12 cards) back / forward; the cursor keeps its place on the screen; at an end: first / last card
local function Page(dir)
  if count == 0 then
    return
  end
  local k = sel - offset
  local rows_total = math.max(1, math.ceil(count / COLS))
  local first = math.max(0, math.min(math.floor(offset / COLS) + dir * ROWS, rows_total - ROWS))
  local new_off = first * COLS
  local new = math.min(count - 1, new_off + k)
  if new_off == offset then
    new = dir > 0 and count - 1 or 0
  end
  if new == sel and new_off == offset then
    return
  end
  sel, offset = new, new_off
  FitOffset()
  funcLuaCommand(C.SE, SE_OK)
  DrawGrid()
  ShowCursor()
  FillDetail()
  UpdateGuideLine()
end

-- L2/R2 (album): first card of the next / previous team (in the rarity order: of the next / previous rarity)
local function Group(dir)
  if count == 0 or not album.on then
    return
  end
  local j = Call(RL.ALBUM, 5, sel, album.order, dir)
  if type(j) ~= "number" then
    return
  end
  j = math.max(0, math.min(count - 1, Int(j)))
  if j == sel then
    return
  end
  sel = j
  offset = math.floor(sel / COLS) * COLS      -- the team's first card on the top row
  FitOffset()
  funcLuaCommand(C.SE, SE_OK)
  DrawGrid()
  ShowCursor()
  FillDetail()
  UpdateGuideLine()
end

-- mouse: the pointer is over grid card k (only cards with a player have their collision on)
local function HoverCard(k)
  if type(k) ~= "number" or k < 0 or k >= N_GRID or offset + k >= count or offset + k == sel then
    return false
  end
  sel = offset + k
  funcLuaCommand(C.SE, SE_OK)
  ShowCursor()
  FillDetail()
  if album.on then
    UpdateGuideLine()
  end
  return true
end

-- mouse wheel: the grid scrolls one row per notch; the cursor keeps its place on the screen
local function Scroll(d)
  if count == 0 then
    return
  end
  local rows_total = math.max(1, math.ceil(count / COLS))
  local first = math.max(0, math.min(math.floor(offset / COLS) + d, rows_total - ROWS))
  if first * COLS == offset then
    return
  end
  sel = math.max(0, math.min(count - 1, sel + first * COLS - offset))
  offset = first * COLS
  FitOffset()
  funcLuaCommand(C.SE, SE_OK)
  DrawGrid()
  ShowCursor()
  FillDetail()
  UpdateGuideLine()
end

-- ---- windows (same patterns as the save-slot screen) -----------------------------------------------------------------
local function Ask(text)
  funcLuaMenuCommand(C.MENU_ACTIVE, MENU, false)
  funcLuaCommand(C.MSG_OPEN, text, 0, 0, 0, 0, 0, false)
  funcLuaCommand(C.MSG_KIND, 2, 0)
  coroutine.yield()
  local r = -1
  while r == nil or r < 0 do
    r = funcLuaCommand(C.MSG_RESULT)
    coroutine.yield()
  end
  while not funcLuaCommand(C.MSG_DONE) do
    coroutine.yield()
  end
  funcLuaMenuCommand(C.MENU_ACTIVE, MENU, true)
  return r == 0
end

local function Message(text)
  funcLuaMenuCommand(C.MENU_ACTIVE, MENU, false)
  funcLuaCommand(C.MSG_OPEN, text, 0, 0, 0, 0, 0, false)
  funcLuaCommand(C.MSG_KIND, 1, 0)
  coroutine.yield()
  while funcLuaCommand(C.MSG_BUSY) do
    coroutine.yield()
  end
  while not funcLuaCommand(C.MSG_DONE) do
    coroutine.yield()
  end
  funcLuaMenuCommand(C.MENU_ACTIVE, MENU, true)
end

local function Close(result)
  closing = true
  funcLuaCommand(C.P_CLEAR, KEY_RESULT)
  funcLuaCommand(C.P_SET, KEY_RESULT, 0, result, 1)
  funcLuaMenuCommand(C.MENU_ACTIVE, MENU, false)
  funcLuaCommand(C.CLOSE_MENU, MENU)
end

-- ---- actions -----------------------------------------------------------------------------------------------------------
local function Decide()
  local e = Current()
  if not has_loader then
    Message(TXT.NO_LOADER)
    return
  end
  if album.on then
    if e == nil then
      Message((album.total > 0 and album.owned >= album.total) and TXT.A_COMPLETE_MSG or TXT.A_EMPTY_MSG)
      return
    end
    local tier = Tier(e)
    if e.owned then
      Message(string.format(TXT.A_INFO_OWNED, e.name, e.tname, tier, Plural(tier), e.cost, TXT.POS[e.position] or TXT.UNKNOWN,
                            TXT.ELEM[e.element] or TXT.UNKNOWN) .. TXT.A_KEYS)
    else
      Message(string.format(TXT.A_INFO_MISSING, e.tname, tier, Plural(tier)) .. TXT.A_KEYS)
    end
    return
  end
  if e == nil then
    Message(TXT.EMPTY_INFO)
    -- test helper, only when [rogue] debug_tools = true in evt_loader\config.toml
    local probe = Call(RL.FILL, 0)
    if probe ~= nil and probe >= 0 and Ask(TXT.ASK_FILL) then
      local n = Int(Call(RL.FILL, 12))
      Log("debug fill", n)
      ReadBank()
      RefreshAll()
      Message(string.format(TXT.FILLED, n))
    end
    return
  end
  if slot_mode.on then
    if not e.fits then
      Message(string.format(TXT.SLOT_BUDGET, e.name, e.scost, slot_mode.left))
      return
    end
    local code = Int(Call(RL.TEAM_SET, slot_mode.slot, e.uid))
    Log("team slot", slot_mode.slot, "uid", e.uid, "param", e.param, "code", code)
    if code ~= 0 then
      Message(string.format(TXT.GO_ERROR, code))
      return
    end
    funcLuaCommand(C.SE, SE_DECIDE)
    Close(1)
    return
  end
  if pick_mode then
    local code, on, n, spent, bud = Call(RL.PICK_TOGGLE, e.uid)
    code = Int(code)
    Log("pick", e.uid, e.param, "code", code, "picked", tostring(on), "n", Int(n), "spent", Int(spent))
    if code == 1 then
      Message(string.format(TXT.PICK_FULL, squad.size))
      return
    elseif code == 2 then
      Message(string.format(TXT.PICK_BUDGET, e.name, e.scost, squad.budget - squad.spent))
      return
    elseif code ~= 0 then
      return
    end
    funcLuaCommand(C.SE, on == true and SE_DECIDE or SE_OK)
    squad.n, squad.spent, squad.budget = Int(n), Int(spent), Int(bud)
    cache, cached = {}, 0              -- picked flags and greys change on every card
    DrawGrid()
    FillDetail()
    UpdateGuideLine()
    return
  end
  local tier = Tier(e)
  Message(string.format(TXT.INFO, e.name, tier, Plural(tier), e.cost, TXT.POS[e.position] or TXT.UNKNOWN,
                        TXT.ELEM[e.element] or TXT.UNKNOWN))
end

local function Go()
  if not pick_mode then
    return
  end
  if squad.n ~= squad.size or squad.spent > squad.budget then
    Message(string.format(TXT.PICK_INCOMPLETE, squad.size, squad.n, squad.budget))
    return
  end
  if not Ask(string.format(TXT.ASK_GO, squad.n, squad.spent, squad.budget)) then
    return
  end
  local code, seed = Call(RL.PICK_COMMIT, 0)
  Log("start run with the squad, code", Int(code), "seed", tostring(seed))
  if Int(code) ~= 0 then
    Message(string.format(TXT.GO_ERROR, Int(code)))
    return
  end
  funcLuaCommand(C.SE, SE_DECIDE)
  Close(1)
end

local function Sort()
  if album.on then
    -- Equipo -> Rareza -> Faltan; the same card stays selected when it is in the new order
    local cur = Current()
    album.order = (album.order + 1) % #TXT.ALBUM_SORT
    Log("album order", album.order)
    funcLuaCommand(C.SE, SE_OK)
    ReadBank()
    sel = 0
    if cur ~= nil then
      local k = Call(RL.ALBUM, 6, cur.param, album.order)
      if type(k) == "number" and k >= 0 and k < count then
        sel = Int(k)
      end
    end
    offset = math.floor(sel / COLS) * COLS
    RefreshAll()
    return
  end
  if count < 2 then
    return
  end
  local cur = Current()
  sort = (sort + 1) % #TXT.SORT
  Log("sort", sort)
  funcLuaCommand(C.SE, SE_OK)
  ReadBank()
  for i = 0, count - 1 do          -- keep the same player selected (uid only: no name lookups)
    local ok, uid = Call(RL.GET, i, sort)
    if ok == true and cur ~= nil and uid == cur.uid then
      sel = i
      break
    end
  end
  RefreshAll()
end

-- L1/R1 page, L2/R2 team (album): CMND_CHECK_INPUT_CMD on MENU_CTRL, polled every frame while no window is open
local function PollKeys()
  if not ready or closing or evt_co ~= nil or not has_loader then
    return
  end
  local function key(k)
    return funcLuaCommand(INPUT.CHECK, INPUT.CTRL, k) == true
  end
  if key(INPUT.PAGE_PREV) then
    Page(-1)
  elseif key(INPUT.PAGE_NEXT) then
    Page(1)
  elseif album.on and key(INPUT.GROUP_PREV) then
    Group(-1)
  elseif album.on and key(INPUT.GROUP_NEXT) then
    Group(1)
  elseif key(INPUT.WHEEL_DOWN) then
    Scroll(1)
  elseif key(INPUT.WHEEL_UP) then
    Scroll(-1)
  end
end

local function StartCo(fn, arg)
  if evt_co ~= nil then
    return
  end
  evt_co = coroutine.create(fn)
  local ok, err = coroutine.resume(evt_co, arg)
  if not ok then
    PRINT("evt_rogue_bank_menu: " .. tostring(err))
    Log("error", tostring(err))
    evt_co = nil
    funcLuaMenuCommand(C.MENU_ACTIVE, MENU, true)
  elseif coroutine.status(evt_co) == "dead" then
    evt_co = nil
  end
end

-- ---- engine callbacks -----------------------------------------------------------------------------------------
function OnInit()
  funcLuaCommand(C.P_CLEAR, KEY_RESULT)
  funcLuaMenuCommand(C.LOAD_TEX, TEX_PATH)
  offset, sel, shown = 0, 0, -1
  local mode = Int(Call(C.P_GET, KEY_MODE))
  pick_mode = mode == 1
  album.on, album.order = mode == 3, 0
  closing, ready = false, false
  slot_mode.on = mode == 2
  if slot_mode.on then
    slot_mode.slot = Int(Call(C.P_GET, KEY_SLOT))
    slot_mode.pos = Int(Call(C.P_GET, KEY_POS))
    local _, _, _, _, spent, bud = Call(RL.TEAM_INFO)
    slot_mode.left = Int(bud) - Int(spent)
  end
  funcLuaCommand(C.P_CLEAR, KEY_MODE)
  ReadBank()
  if pick_mode and has_loader then
    squad.budget = Int(Call(RL.PICK_RESET))
    local _, _, _, _, size = Call(RL.STARTER)
    squad.size = math.max(1, Int(size))
    squad.n, squad.spent = 0, 0
    cache, cached = {}, 0
  end
  Log("open", has_loader, count, "pick_mode", pick_mode, "budget", squad.budget, "album", album.on, album.owned, album.total)
end

function OnSetupLayer(a1, a2)
  if a1 == L_HEADER then
    SetupSoccerTopCommonHeaderLayerInfo(a1, 4153539961, 253801632, 3969848060, 1144161661, 3293713115, 253801632, 1152304044, 305955024, 3007971317)
    SwapSoccerTopCommonHeaderMenuModeIconTexture(1566262113 --[[mode_base02, as the INAROGUE menu]])
    UpdateHeader(3586861540)
    funcLuaMenuCommand(C.SPRITE, a1, 3139293835 --[[#/menu/220_img/evt_rogue/evt_rogue_mode.g4tx]], 2610480106 --[[evt_rogue_mode_plate: INAROGUE's phoenix plate]], 3293713115 --[[header node mode_base01]], 0, 0)
    local head = pick_mode and TXT.HEADER_PICK or (album.on and TXT.HEADER_ALBUM or TXT.HEADER)
    if slot_mode.on then
      head = string.format(TXT.HEADER_SLOT, TXT.SLOT_NAME[slot_mode.pos] or "?")
    end
    funcLuaMenuCommand(C.TEXT, a1, 1220590795 --[[_text_sub_title02]], head)
  elseif a1 == L_ROW then
    funcLuaMenuCommand(C.TEXT, a1, 931545948 --[[_text_list01_on]], "", a2)
    funcLuaMenuCommand(C.TEXT, a1, 3705682548 --[[_text_list01_off]], "", a2)
    funcLuaMenuCommand(CMD_TEXT_VISIBLE, a1, 931545948, false, a2)
    funcLuaMenuCommand(CMD_TEXT_VISIBLE, a1, 3705682548, false, a2)
    for _, m in ipairs(ROW_MESHES) do
      funcLuaMenuCommand(C.MESH_VISIBLE, a1, m, false, a2)
    end
    funcLuaMenuCommand(C.ATTACH_TRACE, a1, a2, CUR, false)
  elseif a1 == L_WINBASE then
    funcLuaMenuCommand(C.MESH_VISIBLE, a1, N.ARROW, false, 0)
    funcLuaMenuCommand(C.ATTACH_TRACE, a1, 0, WIN_LABEL, true)
    funcLuaMenuCommand(C.ATTACH_TRACE, a1, 0, CARD_LABEL, true)
    for k = 1, N_GRID do
      funcLuaMenuCommand(C.ATTACH_TRACE, a1, 0, CRC32(string.format("evt_rogue_bank_grid%02d", k)), true)
    end
    for k = 1, N_GRID + 1 do
      funcLuaMenuCommand(C.ATTACH_TRACE, a1, 0, CRC32(string.format("evt_rogue_bank_mark%02d", k)), true)
    end
    funcLuaMenuCommand(C.OPEN_LAYER, L_WIN, 0)
    for k = 0, N_GRID do
      funcLuaMenuCommand(C.OPEN_LAYER, L_CARD, k)
      funcLuaMenuCommand(C.OPEN_LAYER, L_NEW, k)
    end
  elseif a1 == L_WIN and a2 == 0 then
    FillDetail()
  elseif a1 == L_CARD then
    if a2 == PANEL then
      DrawCard(PANEL, Current())
    else
      FitOffset()
      DrawCard(a2, Entry(offset + a2))
    end
  elseif a1 == L_NEW then
    local e = (a2 == PANEL) and Current() or Entry(offset + a2)
    if e == nil or not FRONT_MARK then
      funcLuaMenuCommand(C.LAYER_VISIBLE, a1, a2, false)
    end
  elseif a1 == L_GUIDE_LINE then
    UpdateGuideLine()
  end
end

function OnOpenLayer(a1, a2)
  if a1 == L_ROW and a2 == 0 then
    funcLuaMenuCommand(C.OPEN_LAYER, L_CURSOR, 0)
    funcLuaMenuCommand(C.FOCUS_ENABLE, L_CARD, true)   -- mouse: the grid cards take hover / click
    funcLuaMenuCommand(C.FOCUS_ENABLE, a1, true)       -- ... but the keys start on the anchor
    funcLuaMenuCommand(C.LIST_NUM, a1, 1)
    funcLuaMenuCommand(C.FOCUS_SET, a1, 0)
    funcLuaMenuCommand(C.ATTACH_TRACE, a1, 0, CUR, false)
    funcLuaMenuCommand(CMD_LOCAL_POS, a1, -4000, 4000, 0, 0)   -- the anchor never shows (off screen, meshes hidden)
    RefreshAll()
    ready = true
    if funcLuaCommand(C.FADE_DONE) then
      funcLuaCommand(C.FADE, 0, 0.3)
    end
  elseif a1 == L_CARD then
    -- retail seasonal list: node names of the card, both cursor labels off (the cursor is traced by Lua)
    NameSetting_CharaCardForSoccer(a1, a2)
    funcLuaMenuCommand(C.ATTACH_TRACE, a1, a2, CARD_CURSOR, false)
    funcLuaMenuCommand(C.ATTACH_TRACE, a1, a2, CARD_CURSOR2, false)
    card_ready[a2] = true
    if a2 == PANEL then
      DrawCard(PANEL, Current())
    else
      DrawCard(a2, Entry(offset + a2))
    end
    if a2 == sel - offset then
      shown = -1
      ShowCursor()
    end
  elseif a1 == L_GUIDE_LINE then
    UpdateGuideLine()
  end
end

-- the anchor never moves; the grid cards are the mouse's focus group (hover)
function OnChangeFocus(a1, a2)
  if a1 ~= L_CARD or evt_co ~= nil or not ready or closing then
    return
  end
  local k = funcLuaMenuCommand(MS.FOCUS_IDX, L_CARD)
  HoverCard(type(k) == "number" and k or a2)
end

-- decide: keys on the anchor row (the selected card) or a click / Enter on grid card k
local function DecideAt(k)
  if evt_co ~= nil or decided or not ready or closing then
    return
  end
  if k ~= nil then
    if type(k) ~= "number" or k < 0 or k >= N_GRID or offset + k >= count then
      return
    end
    HoverCard(k)
  end
  decided = true
  StartCo(Decide)
end

function OnDecideFocus(a1, a2)
  if a1 == L_ROW then
    DecideAt(nil)
  elseif a1 == L_CARD then
    local k = a2
    if type(k) ~= "number" or k < 0 or k >= N_GRID then
      k = funcLuaMenuCommand(MS.FOCUS_IDX, L_CARD)
    end
    DecideAt(k)
  end
end

-- MENU_CMD_INFO CMD_FUNCTION ids of the anchor row (arrows, CMD_FUNC2 sort); the button guide
-- sends the same commands when clicked. lua.md: OnFunction(id, layer); both orders are accepted.
function OnFunction(a1, a2)
  if evt_co ~= nil then
    return 1
  end
  local id = a1
  if a1 ~= FN.SORT and a1 ~= FN.GO and a1 ~= FN.UP and a1 ~= FN.DOWN and a1 ~= FN.LEFT and a1 ~= FN.RIGHT then
    id = a2
  end
  if id == FN.UP then
    Move(-COLS)
  elseif id == FN.DOWN then
    Move(COLS)
  elseif id == FN.LEFT then
    Move(-1)
  elseif id == FN.RIGHT then
    Move(1)
  elseif id == FN.SORT then
    StartCo(Sort)
  elseif id == FN.GO then
    if pick_mode then
      StartCo(Go)
    end
  else
    return
  end
  return 1
end

function OnEnter(a1, a2)
  if a1 == L_BTN or a1 == L_RET then
    return 1
  end
  if a1 == L_ROW then
    OnDecideFocus(a1, a2)   -- the coroutine guard ignores the second call
  elseif a1 == L_CARD then
    DecideAt(a2)            -- Enter after the mouse left the engine focus on a card (kept in step by ShowCursor)
  end
end

function OnBack(a1)
  if evt_co ~= nil then
    return 1
  end
  funcLuaCommand(C.SE, SE_BACK)
  Close(0)
  return 1
end

function Step()
  decided = false
  PollFaces()
  PollKeys()
  if evt_co ~= nil then
    if coroutine.status(evt_co) == "dead" then
      evt_co = nil
    else
      local ok, err = coroutine.resume(evt_co)
      if not ok then
        PRINT("evt_rogue_bank_menu: " .. tostring(err))
        Log("error", tostring(err))
        evt_co = nil
        funcLuaMenuCommand(C.MENU_ACTIVE, MENU, true)
      elseif coroutine.status(evt_co) == "dead" then
        evt_co = nil
      end
    end
  end
end
